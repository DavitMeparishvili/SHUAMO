# Copy to deploy/.env.droplet on the Droplet and replace every value.
# Keep the real file private: `chmod 600 deploy/.env.droplet`.
APP_IMAGE=ghcr.io/davitmeparishvili/shuamo:latest

POSTGRES_DB=shuamo
POSTGRES_USER=shuamo_app
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

MINIO_ROOT_USER=shuamo_minio_admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-root-password
MINIO_APP_ACCESS_KEY=shuamo_app
MINIO_APP_SECRET_KEY=replace-with-a-long-random-application-secret
MINIO_BUCKET=shuamo-product-images

# Domains without https:// or a trailing slash.
APP_DOMAIN=xurjin.com
STORAGE_DOMAIN=s3.xurjin.com
APP_ORIGIN=https://xurjin.com
STORAGE_PUBLIC_ENDPOINT=https://s3.xurjin.com

AUTH_SECRET=replace-with-a-random-secret-of-at-least-40-characters
FINGERPRINT_SECRET=replace-with-a-random-secret-of-at-least-40-characters
