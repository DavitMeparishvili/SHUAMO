{
  "name": "shuamo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "verify:boundaries": "node scripts/verify-module-boundaries.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "tokens:generate": "tsx scripts/generate-tokens.mjs",
    "tokens:check": "tsx scripts/generate-tokens.mjs --check",
    "db:up": "docker compose up -d --wait postgres-dev postgres-test",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "tsx scripts/run-prisma-test.ts",
    "seed:phase-2": "tsx scripts/seed-phase-02.ts",
    "approve": "tsx scripts/approve-account.ts",
    "brand:key": "tsx scripts/regenerate-brand-key.ts",
    "verify:phase-0": "pnpm format:check && pnpm lint && pnpm verify:boundaries && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm build && pnpm test:e2e --grep-invert \"@phase-\"",
    "verify:phase-1": "pnpm verify:phase-0 && pnpm tokens:check && pnpm test:e2e --grep @phase-1",
    "verify:phase-2": "pnpm verify:phase-1 && pnpm db:migrate:test && pnpm test:integration && pnpm build && pnpm seed:phase-2 && pnpm test:e2e --grep @phase-2"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.28",
    "@fontsource/noto-sans-georgian": "5.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.6.28",
    "decimal.js": "10.6.0",
    "geist": "1.7.2",
    "next": "16.1.0",
    "pg": "8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.1.0",
    "jsdom": "27.0.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
