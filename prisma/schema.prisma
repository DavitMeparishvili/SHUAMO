generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 reads the connection URL from prisma.config.ts for migrations and
// from the driver adapter passed to PrismaClient at runtime. A `url` here is a
// schema validation error, not a fallback.
datasource db {
  provider = "postgresql"
}

/// Exists so Phase 0 can prove migration and round-trip without inventing a
/// domain table. Later phases keep it: /api/health/ready reads it.
model HealthProbe {
  id         String   @id @default(uuid()) @db.Uuid
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)

  @@map("health_probe")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
}

/// SHUAMO's product account. Better Auth owns credentials and sessions.
model AppUser {
  financePayments FinancePayment[] @relation("PaymentActor")
  financeInvoices FinanceInvoice[] @relation("InvoiceActor")
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  locale    String   @default("ka")
  isAdmin   Boolean  @default(false) @map("is_admin")
  accessDisabled Boolean @default(false) @map("access_disabled")
  onboarding Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  brand       Brand?
  creator     Creator?
  auditEvents AuditEvent[]
  authUser    User         @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("app_user")
}

model Brand {
  financePayments FinancePayment[]
  financeInvoices FinanceInvoice[]
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @unique @map("user_id") @db.Uuid
  name          String
  vatRegistered Boolean        @default(false) @map("vat_registered")
  keyPrefix     String         @unique @map("key_prefix")
  keyHash       String         @map("key_hash")
  status        ApprovalStatus @default(PENDING)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user         AppUser       @relation(fields: [userId], references: [id], onDelete: Restrict)
  products     Product[]
  partnerships Partnership[]
  clicks       Click[]
  conversions  Conversion[]
  profile      BrandProfile?
  integrationRequests IntegrationRequest[]

  @@map("brand")
}

model IntegrationRequest {
  id      String   @id @db.Uuid
  brandId String   @map("brand_id") @db.Uuid
  mode    String
  status  Int
  outcome String
  at      DateTime @default(now()) @db.Timestamptz(6)
  brand   Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, at(sort: Desc)], map: "integration_request_brand_at_idx")
  @@map("integration_request")
}

model Creator {
  financePayments FinancePayment[]
  financeInvoices FinanceInvoice[]
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @unique @map("user_id") @db.Uuid
  displayName String         @map("display_name")
  bio         String         @default("")
  status      ApprovalStatus @default(PENDING)
  payoutBank  String?        @map("payout_bank")
  payoutIban  String?        @map("payout_iban")
  payoutName  String?        @map("payout_name")
  isTeamLead  Boolean        @default(false) @map("is_team_lead")
  teamLeadId  String?        @map("team_lead_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user         AppUser         @relation(fields: [userId], references: [id], onDelete: Restrict)
  teamLead     Creator?        @relation("CreatorTeam", fields: [teamLeadId], references: [id], onDelete: Restrict)
  teamMembers  Creator[]       @relation("CreatorTeam")
  partnerships Partnership[]
  links        TrackingLink[]
  attributions Attribution[]
  profile      CreatorProfile?

  @@index([teamLeadId], map: "creator_team_lead_idx")
  @@map("creator")
}

model BrandProfile {
  draftData              Json?         @map("draft_data")
  id                     String        @id @default(uuid()) @db.Uuid
  brandId                String        @unique @map("brand_id") @db.Uuid
  slug                   String?       @unique
  status                 ProfileStatus @default(DRAFT)
  taglineKa              String        @default("") @map("tagline_ka")
  taglineEn              String        @default("") @map("tagline_en")
  descriptionKa          String        @default("") @map("description_ka")
  descriptionEn          String        @default("") @map("description_en")
  locationKa             String        @default("") @map("location_ka")
  locationEn             String        @default("") @map("location_en")
  logoUrl                String        @default("") @map("logo_url")
  heroImageUrl           String        @default("") @map("hero_image_url")
  categories             String[]      @default([])
  whatWeMake             Json          @default("[]") @map("what_we_make")
  collaborationInterests Json          @default("[]") @map("collaboration_interests")
  socialLinks            Json          @default("[]") @map("social_links")
  featuredProductIds     Json          @default("[]") @map("featured_product_ids")
  publishedAt            DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([status, slug], map: "brand_profile_public_idx")
  @@map("brand_profile")
}

model CreatorProfile {
  draftData      Json?         @map("draft_data")
  id             String        @id @default(uuid()) @db.Uuid
  creatorId      String        @unique @map("creator_id") @db.Uuid
  slug           String?       @unique
  status         ProfileStatus @default(DRAFT)
  taglineKa      String        @default("") @map("tagline_ka")
  taglineEn      String        @default("") @map("tagline_en")
  descriptionKa  String        @default("") @map("description_ka")
  descriptionEn  String        @default("") @map("description_en")
  locationKa     String        @default("") @map("location_ka")
  locationEn     String        @default("") @map("location_en")
  heroImageUrl   String        @default("") @map("hero_image_url")
  categories     String[]      @default([])
  languages      String[]      @default([])
  contentFormats String[]      @default([]) @map("content_formats")
  socialLinks    Json          @default("[]") @map("social_links")
  featuredWork   Json          @default("[]") @map("featured_work")
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([status, slug], map: "creator_profile_public_idx")
  @@map("creator_profile")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum ProductType {
  BEAUTY_FRAGRANCE
  BEAUTY_SKINCARE
  BEAUTY_MAKEUP
  FASHION_CLOTHING
  FASHION_SHOES
  FASHION_ACCESSORIES
  HOME_DECOR
  HOME_FRAGRANCE
  FOOD_BEVERAGE
  ELECTRONICS
  HEALTH_WELLNESS
  SPORTS_OUTDOORS
  BABY_KIDS
  BOOKS_STATIONERY
  OTHER
}

enum AffiliatePayoutTiming {
  AFTER_CONFIRMED_CONVERSION
  MONTHLY
  CUSTOM
}

enum PartnershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RateType {
  PERCENT
  FIXED
}

enum LinkStatus {
  ACTIVE
  DISABLED
}

model Product {
  id                         String                @id @default(uuid()) @db.Uuid
  brandId                    String                @map("brand_id") @db.Uuid
  sku                        String
  title                      String
  description                String                @default("")
  productType                ProductType           @default(OTHER) @map("product_type")
  priceGel                   Decimal               @map("price_gel") @db.Decimal(12, 2)
  imageUrls                  String[]              @default([]) @map("image_urls")
  backlinkUrl                String                @map("backlink_url")
  commissionType             RateType              @map("commission_type")
  commissionValue            Decimal               @map("commission_value") @db.Decimal(9, 4)
  cookieWindowDays           Int                   @default(30) @map("cookie_window_days")
  payoutTiming               AffiliatePayoutTiming @default(AFTER_CONFIRMED_CONVERSION) @map("payout_timing")
  allowedChannels            String[]              @default([]) @map("allowed_channels")
  prohibitedPromotionMethods String[]              @default([]) @map("prohibited_promotion_methods")
  availableRegions           String[]              @default([]) @map("available_regions")
  couponPolicy               String                @default("") @map("coupon_policy")
  returnPolicy               String                @default("") @map("return_policy")
  contentRequirements        String                @default("") @map("content_requirements")
  specialTerms               String                @default("") @map("special_terms")
  offerStartsAt              DateTime?             @map("offer_starts_at") @db.Timestamptz(6)
  offerEndsAt                DateTime?             @map("offer_ends_at") @db.Timestamptz(6)
  termsVersion               Int                   @default(1) @map("terms_version")
  termsUpdatedAt             DateTime              @default(now()) @map("terms_updated_at") @db.Timestamptz(6)
  status                     ProductStatus         @default(ACTIVE)
  createdAt                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  links        TrackingLink[]
  attributions Attribution[]

  @@unique([brandId, sku])
  @@map("product")
}

model Partnership {
  id        String            @id @default(uuid()) @db.Uuid
  brandId   String            @map("brand_id") @db.Uuid
  creatorId String            @map("creator_id") @db.Uuid
  status    PartnershipStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([brandId, creatorId])
  @@index([creatorId, status], map: "partnership_creator_idx")
  @@map("partnership")
}

model TrackingLink {
  id              String     @id @default(uuid()) @db.Uuid
  productId       String     @map("product_id") @db.Uuid
  creatorId       String     @map("creator_id") @db.Uuid
  code            String     @unique
  commissionType  RateType   @map("commission_type")
  commissionValue Decimal    @map("commission_value") @db.Decimal(9, 4)
  acceptedTerms   Json       @default("{}") @map("accepted_terms")
  termsAcceptedAt DateTime   @default(now()) @map("terms_accepted_at") @db.Timestamptz(6)
  status          LinkStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  clicks  Click[]

  @@index([productId, creatorId], map: "tracking_link_product_creator_idx")
  @@index([creatorId], map: "tracking_link_creator_idx")
  @@map("tracking_link")
}

/// id is the ck_... token echoed in ?xu=.
/// brandId is denormalised so the submitted click can be rejected cross-brand
/// without inferring its brand through mutable catalogue rows.
/// visitorId, fpHash, and creditable support click-analytics deduplication only.
/// The conversion's submitted click ID resolves its one earning tracking link.
model Click {
  id             String    @id
  trackingLinkId String    @map("tracking_link_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  visitorId      String?   @map("visitor_id") @db.Uuid
  fpHash         String?   @map("fp_hash")
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  creditable     Boolean   @default(true)
  convertedAt    DateTime? @map("converted_at") @db.Timestamptz(6)

  trackingLink TrackingLink  @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict)
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  attributions Attribution[]

  @@index([trackingLinkId, occurredAt(sort: Desc)], map: "click_link_idx")
  @@map("click")
}

enum ConversionStatus {
  CONFIRMED
  CANCELLED
}

enum AttributionStatus {
  CANONICAL
  NONCANONICAL
  MANUAL_REVIEW
}

model Conversion {
  id                 String           @id @default(uuid()) @db.Uuid
  brandId            String           @map("brand_id") @db.Uuid
  orderId            String           @map("order_id")
  requestFingerprint String           @map("request_fingerprint") @db.VarChar(64)
  occurredAt         DateTime         @map("occurred_at") @db.Timestamptz(6)
  status             ConversionStatus @default(CONFIRMED)
  /// Webhook acceptance time; preserved after cancellation.
  confirmedAt        DateTime         @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  brand Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  items ConversionItem[]

  @@unique([brandId, orderId])
  @@index([brandId, status, confirmedAt], map: "conversion_queue_idx")
  @@map("conversion")
}

model ConversionItem {
  id                String   @id @default(uuid()) @db.Uuid
  conversionId      String   @map("conversion_id") @db.Uuid
  sku               String
  qty               Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineDiscount      Decimal  @map("line_discount") @db.Decimal(12, 2)
  lineVat           Decimal  @map("line_vat") @db.Decimal(12, 2)
  commissionableNet Decimal  @map("commissionable_net") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversion  Conversion   @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  attribution Attribution?

  @@index([conversionId], map: "conversion_item_conversion_idx")
  @@map("conversion_item")
}

/// The submitted click is the sole source of creator, product and immutable
/// commission terms. commissionAmount is immutable after insert.
model Attribution {
  financeInvoiceLines FinanceInvoiceLine[]
  id                     String            @id @default(uuid()) @db.Uuid
  conversionItemId       String            @unique @map("conversion_item_id") @db.Uuid
  clickId                String?           @unique(map: "attribution_click_id_key") @map("click_id")
  historicalClickId      String?           @map("historical_click_id")
  canonicalAttributionId String?           @map("canonical_attribution_id") @db.Uuid
  creatorId              String            @map("creator_id") @db.Uuid
  productId              String            @map("product_id") @db.Uuid
  commissionAmount       Decimal           @map("commission_amount") @db.Decimal(12, 2)
  status                 AttributionStatus @default(CANONICAL)
  resolutionNote         String?           @map("resolution_note")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  conversionItem ConversionItem @relation(fields: [conversionItemId], references: [id], onDelete: Cascade)
  click          Click?         @relation(fields: [clickId], references: [id], onDelete: Restrict)
  creator        Creator        @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([creatorId], map: "attribution_creator_idx")
  @@index([historicalClickId], map: "attribution_historical_click_idx")
  @@index([canonicalAttributionId], map: "attribution_canonical_idx")
  @@map("attribution")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  changes    Json     @default("{}")
  at         DateTime @default(now()) @db.Timestamptz(6)

  actor AppUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, at(sort: Desc)], map: "audit_event_entity_idx")
  @@map("audit_event")
}

// Better Auth schema. UUID ids keep User.id compatible with AppUser.id.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Request-scoped transport for the atomic app_user insert trigger. The
  // trigger clears it before the insert statement completes.
  signupLocale  String?   @map("signup_locale")
  sessions      Session[]
  accounts      Account[]
  appUser       AppUser?

  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}
enum FinancePaymentKind {
  PAYMENT
  REVERSAL
}

enum FinanceInvoicePartyKind {
  BRAND
  CREATOR
}

model FinancePayment {
  id String @id @default(uuid()) @db.Uuid
  requestKey String @unique @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  kind FinancePaymentKind
  brandId String? @map("brand_id") @db.Uuid
  creatorId String? @map("creator_id") @db.Uuid
  amount Decimal @db.Decimal(12, 2)
  transferredOn DateTime @map("transferred_on") @db.Date
  bankReference String? @map("bank_reference") @db.VarChar(160)
  note String? @db.VarChar(1000)
  partySnapshot Json @map("party_snapshot")
  invoiceId String? @map("invoice_id") @db.Uuid
  reversesId String? @unique @map("reverses_id") @db.Uuid
  recordedById String @map("recorded_by_id") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  invoice FinanceInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reverses FinancePayment? @relation("PaymentReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal FinancePayment? @relation("PaymentReversal")
  recordedBy AppUser @relation("PaymentActor", fields: [recordedById], references: [id], onDelete: Restrict)
  @@index([brandId, transferredOn])
  @@index([creatorId, transferredOn])
  @@index([invoiceId])
  @@map("finance_payment")
}

model FinanceInvoice {
  id String @id @default(uuid()) @db.Uuid
  requestKey String @unique @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  previewHash String @map("preview_hash") @db.Char(64)
  number String @unique
  brandId String? @map("brand_id") @db.Uuid
  creatorId String? @map("creator_id") @db.Uuid
  payerSnapshot Json @map("payer_snapshot")
  payeeSnapshot Json @map("payee_snapshot")
  total Decimal @db.Decimal(18, 2)
  currency String @default("GEL")
  issuedById String @map("issued_by_id") @db.Uuid
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  issuedBy AppUser @relation("InvoiceActor", fields: [issuedById], references: [id], onDelete: Restrict)
  lines FinanceInvoiceLine[]
  payments FinancePayment[]
  @@index([brandId, issuedAt])
  @@index([creatorId, issuedAt])
  @@map("finance_invoice")
}

model FinanceInvoiceLine {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  attributionId String @map("attribution_id") @db.Uuid
  amount Decimal @db.Decimal(12, 2)
  snapshot Json
  invoice FinanceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  attribution Attribution @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  @@unique([invoiceId, attributionId])
  @@index([attributionId])
  @@map("finance_invoice_line")
}

model FinanceInvoiceCounter {
  kind FinanceInvoicePartyKind
  year Int
  lastValue Int @map("last_value")
  @@id([kind, year])
  @@map("finance_invoice_counter")
}
